{
  "name": "accessibility-ninja",
  "version": "0.1.0",
  "private": true,
  "description": "Speaker-reviewed slide reading companions for blind and low-vision conference attendees",
  "scripts": {
    "start": "NODE_USE_SYSTEM_CA=1 node --env-file=../.env server.js",
    "start:dash0": "NODE_USE_SYSTEM_CA=1 NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register' node --env-file=../.env server.js"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "engines": { "node": ">=20.6" }
}
